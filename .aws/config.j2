# vim: ft=cfg
[profile shore]
region = us-east-1

[profile schoolinks-prod-admin]
region = us-east-1
sso_session = schoolinks
sso_account_id = {{ run(["ph", "show", "--field", "Account ID", "SchooLinks/AWS SSO"])["stdout"] }}
sso_role_name = AdministratorAccess

[profile schoolinks-prod-readonly]
region = us-east-1
sso_session = schoolinks
sso_account_id = {{ run(["ph", "show", "--field", "Account ID", "SchooLinks/AWS SSO"])["stdout"] }}
sso_role_name = ReadOnlyAccess

[profile schoolinks-prod-deployers]
region = us-east-1
sso_session = schoolinks
sso_account_id = {{ run(["ph", "show", "--field", "Account ID", "SchooLinks/AWS SSO"])["stdout"] }}
sso_role_name = TerraformDeployersAccess

[profile schoolinks-dev]
region = us-east-1
sso_session = schoolinks
sso_account_id = {{ run(["ph", "show", "--field", "Dev account ID", "SchooLinks/AWS SSO"])["stdout"] }}
sso_role_name = AdministratorAccess

[profile schoolinks-sandbox]
region = us-east-1
sso_session = schoolinks
sso_account_id = {{ run(["ph", "show", "--field", "Sandbox account ID", "SchooLinks/AWS SSO"])["stdout"] }}
sso_role_name = AdministratorAccess

[profile schoolinks-districts]
region = us-east-1
sso_session = schoolinks
sso_account_id = {{ run(["ph", "show", "--field", "Districts account ID", "SchooLinks/AWS SSO"])["stdout"] }}
sso_role_name = AdministratorAccess

[sso-session schoolinks]
sso_start_url = https://schoolinks-sso.awsapps.com/start
sso_region = us-east-1
sso_registration_scopes = sso:account:access
